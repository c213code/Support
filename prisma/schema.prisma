// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum IssueStatus {
  RESOLVED
  PENDING
  IN_PROGRESS
  SENT
  // Тикет передан другой команде (Backend/Frontend/Product, см.
  // src/lib/escalation.ts) — тот же "в работе", но работа не на стороне
  // саппорта. Третья кнопка внутри колонки "В работе / Пендинг" на доске.
  ESCALATED
}

model GroupPreset {
  id        String   @id @default(cuid())
  name      String   @unique
  emoji     String?
  order     Int      @default(0)
  // Telegram chat id — чтобы автоматически распознавать входящие сообщения по группе
  chatId    String?  @unique
  createdAt DateTime @default(now())
}

model TelegramMessage {
  id               String   @id @default(cuid())
  chatId           String
  messageId        Int
  chatTitle        String?
  groupName        String?
  groupEmoji       String?
  // Telegram user id автора — чтобы склеивать несколько подряд идущих
  // сообщений одного и того же человека в один запрос во "Входящих".
  // BigInt, не Int: у многих Telegram-аккаунтов id уже больше 2^31 и не
  // помещается в 32-битный integer.
  fromId           BigInt?
  authorName       String?
  text             String?
  // Какой тикет агент обсуждал этой своей репликой. Заполняется только у
  // собственных сообщений агентов и только автоматически — по стрелке
  // реплая, по своей же предыдущей реплике или по последнему обращению
  // выше (см. lib/agentThread.ts). Отдельно от usedForIssueId нарочно:
  // там лежат сообщения, ИЗ которых состоит обращение (их текст идёт в
  // подсказки и в описание), а здесь — то, что мы САМИ сказали по нему.
  // Тикет по этому сообщению осознанно НЕ заводили: это ответ нашему же
  // агенту или реплай самому себе (см. skipAutoCreate в вебхуке). Флаг
  // нужен, потому что решение обязано пережить склейку сообщений: человек
  // дописывает следующей фразой через несколько секунд, и без памяти о
  // пропуске серия заводила тикет, который поштучно каждое сообщение
  // заводить отказалось.
  skippedAutoIssue Boolean  @default(false)
  agentIssueId     String?
  agentIssue       Issue?   @relation("issueAgentReply", fields: [agentIssueId], references: [id], onDelete: SetNull)
  // На какое сообщение этого чата отвечали (Telegram Reply). Нужно, чтобы
  // потом, уже вне момента доставки, найти реплику агента, относящуюся к
  // конкретному тикету: "жасалды" в ответ на сообщение с проблемой — это и
  // есть готовая заметка о решении (см. lib/resolutionNote.ts). Текст
  // цитаты в `text` для этого не годится: Telegram обрезает её до 200
  // символов, и сопоставление по строке разъезжается.
  replyToMessageId Int?
  messageLink      String
  archived         Boolean  @default(false)
  // Просмотрено ли сообщение на сайте — для индикатора "новое/просмотрено"
  viewed           Boolean  @default(false)
  usedForIssueId   String?
  // SetNull, а не каскад: сообщение остаётся во "Входящих" и его можно
  // завести заново. Раньше это делалось руками в DELETE /api/issues/[id]
  // с комментарием "внешнего ключа нет, чистим сами".
  usedForIssue     Issue?   @relation("issueSource", fields: [usedForIssueId], references: [id], onDelete: SetNull)
  receivedAt       DateTime @default(now())

  @@unique([chatId, messageId])
  @@index([archived, receivedAt])
  // Окно чата за последние минуты — по нему ищется тикет, к которому
  // относится реплика агента, написанная без Reply.
  @@index([chatId, receivedAt])
  // По этим полям ходят сбор заметки, слияние тикетов и удаление тикета.
  @@index([usedForIssueId])
  @@index([agentIssueId])
}

// Единственная строка (id всегда "singleton") с глобальными переключателями
// приложения — сейчас только тогл "описания авто-тикетов пишет ИИ вместо
// регулярок". Не привязано к конкретному агенту/сессии осознанно: это
// настройка для всей команды, а не личное предпочтение.
model AppSetting {
  id                 String   @id @default("singleton")
  aiCleaningEnabled  Boolean  @default(false)
  // Общий рубильник автоответов бота в рабочие группы (подтверждение
  // приёма, реакция на смену статуса — см. src/lib/autoReply.ts). Выключен
  // по умолчанию осознанно: это единственная фича, которая пишет от имени
  // школы в чат, где сидят коллеги, — включать её должен человек, а не
  // деплой.
  autoReplyEnabled   Boolean  @default(false)
  // Отдельный рубильник для обратного направления: бот читает реплики
  // агента в группе и сам двигает статусы (см. src/lib/agentIntent.ts).
  // Отдельный от autoReplyEnabled намеренно — это разные риски: там бот
  // пишет коллегам, тут молча меняет то, что уйдёт в репорт боссам, и
  // выключать одно, не трогая другое, надо уметь.
  chatIntentEnabled  Boolean  @default(false)
  // Автоответ на приём обращения (buildAckText в src/lib/autoReply.ts)
  // просит почту/ссылку ученика по жёсткому regex-признаку "есть ли она уже
  // в тексте" — это ловит и общие вопросы без ученика (график работы,
  // как что устроено), которым такая просьба не по делу, и не различает
  // "нужна почта" от "нужна ещё и ай-апта" (обращение про конкретное
  // задание по программе). Этот тогл включает ИИ-классификацию
  // (classifyAckAsk в lib/ai.ts) поверх той же логики: уточняет, только
  // когда regex уже сказал "просить" — то есть сужает/детализирует ложные
  // срабатывания, а не отменяет проверку целиком. Выключен по умолчанию по
  // тому же принципу, что и остальные ИИ/автоответ-тоглы.
  aiAskEnabled       Boolean  @default(false)
  // Спрашивать в личке перед тем, как ответить в рабочей группе. Работает
  // поверх autoReplyEnabled и только для подтверждения приёма: реакция на
  // смену статуса — следствие осознанного действия человека, её
  // переспрашивать незачем. По умолчанию включено: если уж бот пишет
  // коллегам, то первым режимом должен быть тот, где последнее слово за
  // человеком.
  autoReplyConfirm   Boolean  @default(true)
  // Отвечать ли в группу при смене статуса на сайте (перетащили карточку в
  // "В работе" — бот пишет "жұмысқа алдық"). Отдельно от подтверждения
  // приёма: там бот сообщает, что обращение вообще увидели, а здесь —
  // сопровождает работу, и это первое, что начинает раздражать, когда
  // тикет двигают несколько раз за день. Эмодзи-реакция остаётся в любом
  // случае: она не шумит.
  statusReplyEnabled Boolean  @default(true)
  // ИИ-разбор логов ученика на странице "Логи" (investigateStudentLogs в
  // lib/ai.ts). Отдельный рубильник от aiCleaningEnabled намеренно: риск
  // другой. Описания тикетов — это текст обращения, а сюда во внешнюю
  // модель уходят тела запросов и ответов самой платформы, где попадаются
  // ссылки восстановления пароля и токены. Выключено по умолчанию —
  // включает человек, а не деплой.
  logsAiEnabled      Boolean  @default(false)
  // Сообщать автору обращения из мини-аппа в личку, когда у его тикета
  // сменился статус (см. src/lib/submitterNotify.ts). Включено по умолчанию,
  // в отличие от остальных «бот пишет людям» тоглов: пока submissionToGroup
  // выключен, у таких обращений нет сообщения в рабочей группе, и без этого
  // куратор вообще никогда не узнаёт, что с его заявкой, — отсутствие ответа
  // и было жалобой. Рубильник нужен, чтобы выключить, если поток окажется
  // шумным.
  submitterNotify    Boolean  @default(true)
  // Публиковать ли обращение из формы в рабочей группе, которую выбрал
  // куратор. Выключено по умолчанию: это бот пишет туда, где сидят коллеги.
  // Включённым оно делает форму видимой всей группе — коллеги знают, что
  // вопрос задан, а ответ реплаем приклеивается к тому же тикету.
  submissionToGroup  Boolean  @default(false)
  updatedAt          DateTime @updatedAt
}

// Переписка, которую куратор переслал боту в личку, собранная в черновик
// обращения. Кураторы часто не пишут запрос заново, а пересылают готовую
// цепочку из своего чата: шесть сообщений подряд, среди них скрины и
// логин с паролем. Перепечатывать это в форму никто не станет, поэтому
// пересланное копится здесь, а мини-апп открывается уже заполненным.
//
// Черновик один на куратора: следующая пересылка после паузы начинает
// новый, а не дописывает вчерашний.
model ForwardDraft {
  id             String   @id @default(cuid())
  telegramUserId BigInt   @unique
  // Тексты пересланных сообщений по порядку, через перевод строки.
  text            String
  photoFileIds    String[] @default([])
  // Сообщение бота «собрано столько-то» с кнопкой: его же и редактируем на
  // каждую следующую пересылку, чтобы не плодить экраны (см. правило про
  // экраны бота в CLAUDE.md).
  promptChatId    String?
  promptMessageId Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// «Авто-репорт»: один запуск вечернего разбора по дню (lib/dayReconcile.ts).
//
// Хранится не ради отладки, а как журнал для людей: вечером видно, что ИИ
// посчитал сделанным, на какой цитате из чата это основано и совпало ли с
// тем, что дежурные применили. Без журнала проверить, можно ли доверять
// разбору, было бы нечем.
model ReconcileRun {
  id         String             @id @default(cuid())
  reportDate String
  // Какая модель разбирала: при сравнении моделей видно, кто где ошибся.
  model      String
  startedBy  String
  createdAt  DateTime           @default(now())
  finishedAt DateTime?
  verdicts   ReconcileVerdict[]

  @@index([reportDate])
}

// Решение разбора по одному тикету. Ничего не меняет само: статус тикета
// меняется только когда человек отметил решение и нажал «Применить»
// (appliedAt/appliedBy), и только через changeIssueStatus.
model ReconcileVerdict {
  id           String       @id @default(cuid())
  runId        String
  run          ReconcileRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  issueId      String
  issue        Issue        @relation(fields: [issueId], references: [id], onDelete: Cascade)
  statusBefore IssueStatus
  // pending — ещё не разобран; done — модель ответила; skipped — в чате нет
  // точно привязанных реплик, судить не по чему; error — модель не ответила.
  state        String       @default("pending")
  // RESOLVED | IN_PROGRESS | PENDING | ESCALATED | UNCLEAR
  proposed     String?
  note         String?
  evidence     String?
  // Почему модель так решила (одна фраза) и что именно она видела —
  // описание и ленту переписки. По ним ошибка разбора видна сразу, без
  // похода в базу и чат.
  // Тикет, продолжением которого похоже является этот (тот же автор, та же
  // проблема, разнесло на два дня) — окно предлагает объединить. Просто id:
  // целевой могли удалить, это проверяется при объединении.
  mergeTargetId String?
  reason       String?
  input        String?
  // Кто ответил в чате — его имя пойдёт в «X шешті».
  resolver     String?
  error        String?
  appliedAt    DateTime?
  appliedBy    String?
  createdAt    DateTime     @default(now())

  @@index([runId])
  @@index([issueId])
}

// Что именно бот написал в рабочую группу по конкретному тикету. Нужна
// ровно для двух вещей: не отправить одно и то же дважды и суметь потом
// исправить/удалить неудачный ответ (Telegram позволяет это только по
// message_id и только в течение 48 часов — см. src/lib/botReply.ts).
model BotReply {
  id        String   @id @default(cuid())
  // Каскад: удалили тикет — ответы бота по нему больше ни к чему не
  // относятся. Раньше внешнего ключа не было вовсе, и такие строки
  // оставались висеть навсегда.
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  issueId   String
  chatId    String
  messageId Int
  // Какой это был ответ: ACK (подтверждение приёма), статусный (по имени
  // IssueStatus) или FOLLOW_UP (ответ на повторное обращение). Строкой, а
  // не enum: набор поводов будет прирастать, а заводить миграцию ради
  // каждого нового повода незачем.
  kind      String
  text      String
  // Только у поста обращения из формы: разметка с местом под строку
  // статуса и признак «подпись к фото». По ней бот переписывает строку
  // статуса внизу поста при каждой смене статуса (submissionGroupPost.ts).
  // JSON, у старых постов — null: их статус не обновляется.
  layout    String?
  deleted   Boolean  @default(false)
  sentAt    DateTime @default(now())

  @@unique([chatId, messageId])
  @@index([issueId])
}

// Отмечает, что репорт за конкретный день уже был отправлен в рабочую
// группу (кнопкой "📤 Отправить в группу" — из вечерней сводки или
// утреннего напоминания, см. /api/cron/*). Без этого утренний cron не
// смог бы отличить "ещё не отправляли" от "отправили вчера вечером" и
// продублировал бы репорт в чат с боссами.
model ReportSendLog {
  reportDate String   @id
  sentAt     DateTime @default(now())
}

// Ожидание текстового ответа на конкретный тикет из Telegram — когда
// нажали "📝 Заметка" под тикетом в сводке, бот шлёт отдельное сообщение
// с просьбой ответить (Reply) на него текстом заметки; эта строка
// связывает то prompt-сообщение с тикетом, чтобы отличить такой ответ от
// обычного сообщения агента (см. ISSUE_NOTE_PREFIX в вебхуке). Одноразовая
// — удаляется сразу после того, как ответ пришёл и заметка сохранена.
model PendingNotePrompt {
  id             String       @id @default(cuid())
  chatId         String
  messageId      Int
  issue          Issue        @relation(fields: [issueId], references: [id], onDelete: Cascade)
  issueId        String
  // Если задан — при получении ответа применяется не только текст
  // заметки, но и этот статус ("✅ Решено"/"⏳ Пендинг" на карточке
  // разбора требуют "как решили"/"что сейчас" перед сменой статуса, по
  // аналогии с ResolveDialog на сайте). Null — старое поведение "просто
  // заметка" (кнопка "📝 Заметка"), статус не трогаем.
  targetStatus   IssueStatus?
  // Предлагать ли после сохранения заметки кнопку "сообщить в чат". Нужно,
  // только когда решение пришло из разбора: в группе о нём ещё не знают.
  // Если же статус проставился потому, что агент сам написал в группе
  // "жөңделді", предлагать нечего — там уже всё сказано.
  offerChatReply Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@unique([chatId, messageId])
}

// Разбор нерешённых тикетов дня по одному, а не сеткой кнопок на все
// сразу (на насыщенный день — 40+ кнопок в одном сообщении, нечитаемо) —
// см. buildTicketCard/advanceReviewSession в src/lib/dailyReview.ts. На
// чат — одна активная сессия: очередь id тикетов зафиксирована на момент
// старта (currentIndex — позиция в ней); каждое действие
// (статус/эскалация/заметка/пропустить) редактирует то же самое
// сообщение и сразу показывает следующий тикет.
// Черновик автоответа, ждущий подтверждения в личке. Текст здесь, а не в
// callback_data: там 64 байта, в них не влезет даже одна фраза, не говоря
// про несколько вариантов.
//
// Ключ — сообщение-вопрос в личке: по нему находится черновик и когда
// нажали кнопку, и когда ответили реплаем своим текстом.
model PendingAutoReply {
  id              String   @id @default(cuid())
  // Личка агента, которому задан вопрос, и id самого вопроса.
  chatId          String
  messageId       Int
  issue           Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  issueId         String
  // Куда отправлять, если подтвердят: рабочая группа и то сообщение, на
  // которое бот отвечает реплаем.
  targetChatId    String
  targetMessageId Int
  // Варианты ответа по порядку — первый показан как основной.
  variants        String[]
  createdAt       DateTime @default(now())

  @@unique([chatId, messageId])
  @@index([issueId])
}

model ReviewSession {
  chatId       String   @id
  reportDate   String
  messageId    Int
  ticketIds    String[]
  currentIndex Int      @default(0)
  createdAt    DateTime @default(now())
}

// Разбор найденных ИИ похожих тикетов дня по одной группе за раз — та же
// "одно сообщение, редактируем на месте" механика, что и у ReviewSession,
// только элемент очереди — группа id, а не один тикет, поэтому group
// хранится как JSON-строка (Prisma String[] не умеет массив массивов).
// См. src/lib/dedupeReview.ts.
model DuplicateReviewSession {
  chatId       String   @id
  reportDate   String
  messageId    Int
  groupsJson   String
  currentIndex Int      @default(0)
  createdAt    DateTime @default(now())
}

// Черновик объявления, разосланного командой /broadcast по всем
// привязанным группам (наблюдалось живьём: одно и то же сообщение про
// работы на платформе отправляли руками в четыре чата подряд). Хранится
// отдельной строкой, потому что в callback_data подтверждения текст не
// влезет — там лимит 64 байта.
model BroadcastDraft {
  id        String   @id @default(cuid())
  text      String
  createdAt DateTime @default(now())
}

// Знание о предметной области, накопленное из собственной переписки: что
// значит "ДТ", "ПФ", "АА", какие сценарии повторяются каждый день. Модель
// этого знать не может — это внутренний жаргон JUZ40, а не общеизвестные
// термины, и без него ИИ чистит описания вслепую, теряя суть обращения.
//
// Собирается из уже решённых тикетов (см. src/lib/projectContext.ts) и
// подмешивается во все запросы к модели. Термин можно поправить или
// добавить руками — auto=false защищает его от перезаписи при следующей
// пересборке.
model GlossaryTerm {
  id        String   @id @default(cuid())
  // Термин в том виде, в каком он встречается в переписке ("ДТ", "ПФ").
  term      String   @unique
  meaning   String
  // false — вписано человеком, пересборка такое не трогает.
  auto      Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// История статусов тикета. До неё нельзя было ответить ни на один вопрос
// про работу отдела: сколько прошло от обращения до ответа, сколько до
// решения, какая доля закрывается прямо из чата, а какая руками на сайте.
// В самом Issue лежит только текущее состояние, а это конец истории без
// самой истории.
model IssueEvent {
  id      String       @id @default(cuid())
  issue   Issue        @relation(fields: [issueId], references: [id], onDelete: Cascade)
  issueId String
  // null у самого первого события — тикета до него не существовало.
  from    IssueStatus?
  to      IssueStatus
  // Имя агента либо "Бот": статус двигает и живой человек, и разбор
  // реплики в группе.
  actor   String
  // "app" — сайт или разбор, "chat" — реплика агента в рабочей группе.
  // Тот же смысл, что у source в reactToStatusChange.
  source  String
  at      DateTime     @default(now())

  @@index([issueId, at])
  @@index([at])
}

model Issue {
  id                String      @id @default(cuid())
  // Дата репорта в формате YYYY-MM-DD (день, за который идёт отчёт)
  reportDate        String
  groupName         String
  groupEmoji        String?
  position          Int         @default(0)
  description       String
  // Ссылка на исходное сообщение. Осталась отдельным полем (а не первым
  // элементом extraLinks), чтобы не переливать данные существующих тикетов
  // миграцией — она накатывается сама при деплое, а data-миграции так
  // гонять нельзя.
  telegramLink      String?
  // Ссылки на дополнительные сообщения, приклеенные к этому же тикету:
  // один и тот же запрос ("доступ беру") часто прилетает несколько раз от
  // разных людей, и это один тикет с несколькими пруфами, а не N тикетов.
  extraLinks        String[]    @default([])
  status            IssueStatus @default(PENDING)
  note              String?
  ticketLink        String?
  // Заполняются только при status = ESCALATED: какой команде передали и
  // кто там занимается. Не выносил в отдельную модель — это просто два
  // поля на тикете, а не связь с чем-то, что живёт своей жизнью.
  escalatedTeam     String?
  escalatedAssignee String?
  createdBy         String
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  // Когда статус менялся в последний раз. Отдельно от updatedAt нарочно:
  // тот обновляется от любой правки — поправили описание, ИИ переписал
  // текст, автор сменился с "Бот" на живого агента, — и "сколько тикет
  // висит в работе" по нему считается неверно. Пишется только из
  // changeIssueStatus (src/lib/issueStatus.ts), единственного места, где
  // статус вообще меняется.
  statusChangedAt   DateTime    @default(now())

  events         IssueEvent[]
  pendingReplies PendingAutoReply[]
  botReplies     BotReply[]
  notePrompts    PendingNotePrompt[]
  sourceMessages TelegramMessage[]   @relation("issueSource")
  agentReplies   TelegramMessage[]   @relation("issueAgentReply")
  // Тикет подан формой из мини-аппа Telegram, а не сообщением в рабочей
  // группе — поля формы лежат отдельно, см. IssueSubmission. Заявок может
  // быть несколько: при склейке тикетов они переезжают на основной.
  submissions    IssueSubmission[]
  // Что вечерний разбор думал об этом тикете (см. ReconcileRun).
  reconcileVerdicts ReconcileVerdict[]

  @@index([reportDate])
  // Библиотека решений (src/lib/solutionLibrary.ts) на каждой карточке
  // разбора ищет закрытые тикеты за последний месяц — без этого индекса
  // это скан всей таблицы, и он растёт вместе с историей.
  @@index([status, reportDate])
}

// Обращение, поданное куратором через форму мини-аппа (/miniapp). Отдельной
// таблицей, а не колонками в Issue: такие поля есть у малой доли тикетов, а
// Issue читают все — доска, репорт, бот. Удаляется вместе с тикетом, как
// BotReply и IssueEvent.
//
// Не @unique по issueId: при склейке тикетов (src/lib/mergeIssue.ts) заявка
// переезжает на основной тикет, а не удаляется каскадом — иначе куратор
// потерял бы своё обращение из списка «Менің өтініштерім».
model IssueSubmission {
  id                 String   @id @default(cuid())
  issueId            String
  issue              Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  // Кто подал — из initData, которую подписывает Telegram (src/lib/miniapp.ts),
  // а не из полей формы: подделать автора нельзя.
  telegramUserId     BigInt
  authorName         String
  // Текст как его ввёл куратор. Описание тикета проходит чистку/ИИ, а здесь
  // то, что написано на самом деле — из него же считаются подсказки карточки.
  rawText            String
  studentContact     String
  lessonLink         String
  // Сами фото хранит Telegram (закрытый канал TELEGRAM_STORAGE_CHAT_ID), у
  // нас только file_id — агенту их отдаёт GET /api/issues/[id]/photo?i=N.
  //
  // photoFileId — первое фото. Осталось от времён, когда фото было ровно
  // одно: так миграция не переписывает уже поданные обращения, и старые
  // заявки (у них photoFileIds пуст) продолжают открываться.
  photoFileId        String
  photoFileIds       String[] @default([])
  // id отправки из формы: повтор той же отправки (ответ потерялся, куратор
  // нажал ещё раз) находит уже заведённый тикет, а не заводит второй.
  clientSubmissionId String?  @unique
  createdAt          DateTime @default(now())
  // Какую типовую проблему выбрал куратор на первом экране формы (см.
  // lib/submissionLabels.ts) и что он заполнил в её полях.
  //
  // Зачем отдельно от rawText: под каждый ярлык форма спрашивает своё —
  // старый и новый номер, почту родителя и ученика, тип урока. Разобрать это
  // обратно из сплошного текста нельзя, а агенту и платформенным кнопкам
  // (смена почты) нужны именно поля, а не абзац. null — заявка подана до
  // появления ярлыков либо через «Басқа мәселе».
  labelId            String?
  // { "<id поля>": "значение" | ["значение", …] } — форма ярлыка описана
  // кодом, поэтому здесь ровно то, что она спросила, без своей таблицы на
  // каждый набор полей.
  labelFields        Json?
  // Переписка с куратором по этой заявке — см. SubmissionMessage.
  messages           SubmissionMessage[]

  @@index([issueId])
  @@index([telegramUserId, createdAt])
}

// Переписка дежурного с куратором, подавшим обращение через мини-апп.
// Живёт в личке бота: дежурный пишет с сайта под тикетом, куратору это
// приходит от бота, и он отвечает там же. Своего чата у мини-аппа нет
// намеренно — кураторы и так сидят в Telegram.
model SubmissionMessage {
  id           String          @id @default(cuid())
  submission   IssueSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  submissionId String
  // true — написал дежурный (ушло куратору в личку), false — ответ куратора.
  fromAgent    Boolean
  // Кто написал: имя дежурного по сессии сайта или имя куратора из Telegram.
  // Куратору имя дежурного не показывается — для него это разговор с ботом.
  authorName   String
  text         String
  // Фото из ответа куратора: у нас только file_id, как и у самой заявки
  // (см. комментарий к photoFileIds выше).
  photoFileIds String[]        @default([])
  // id сообщения бота в личке куратора. По нему ответ стрелкой попадает в
  // нужную переписку, даже когда у куратора открыто несколько обращений.
  telegramMessageId Int?
  // Когда дежурный увидел ответ на доске — по этому полю считается
  // «есть новый ответ» на карточке тикета.
  readAt       DateTime?
  createdAt    DateTime        @default(now())

  @@index([submissionId, createdAt])
  @@index([telegramMessageId])
}

// Сообщение куратора, пришедшее в личку без ответа стрелкой, когда
// непонятно, к какому из его обращений оно относится. Бот спрашивает
// кнопками «Қай өтініш бойынша?» и держит текст здесь, пока тот не выберет.
// Без этого пришлось бы либо гадать, либо терять сообщение.
model PendingCuratorMessage {
  id              String   @id @default(cuid())
  telegramUserId  BigInt
  chatId          String
  // Сообщение бота с кнопками: по нему находим этот черновик при нажатии.
  promptMessageId Int
  text            String
  photoFileIds    String[] @default([])
  createdAt       DateTime @default(now())

  @@unique([chatId, promptMessageId])
  @@index([telegramUserId, createdAt])
}

// Попытки подать обращение через форму мини-аппа — для лимита в час (POST
// /api/miniapp/submit). Отдельно от IssueSubmission: считать надо и
// отклонённые попытки (каждая может стоить запроса к ИИ), а заявка
// появляется только у удачных. Старше суток — удаляет тот же маршрут.
model MiniAppAttempt {
  id             String   @id @default(cuid())
  telegramUserId BigInt
  // Что именно делал куратор: "submit" — отправка обращения, "check" —
  // проверка, занят ли новый номер/почта на платформе. Лимиты у них разные:
  // обращений в час немного, а проверок при наборе номера может быть
  // десяток, и мешать их в один счётчик значит блокировать форму на ровном
  // месте. Старые записи (до появления проверок) — это отправки.
  kind           String   @default("submit")
  createdAt      DateTime @default(now())

  @@index([telegramUserId, createdAt])
  @@index([createdAt])
}

// Журнал смен почты ученикам в основной платформе JUZ40
// (api.juz40-edu.kz) через инструмент /platform/change-email. Платформа —
// отдельная система со своей БД, её данные тут не храним; это только след
// того, что инструмент сделал: кто из агентов, какому ученику, с какой
// почты на какую и когда. Нужен, потому что меняем прод-данные учеников —
// без журнала «кто это сделал» не ответить.
model PlatformEmailChange {
  id          String   @id @default(cuid())
  // Имя агента из сессии Support (getCurrentIdentity().name), а не из клиента.
  actor       String
  // UUID ученика в платформе (в её API это id).
  studentId   String
  // ФИО на момент смены — чтобы журнал читался без похода в платформу.
  studentName String?
  oldEmail    String
  newEmail    String
  at          DateTime @default(now())

  @@index([at])
  @@index([studentId, at])
}

// Журнал обнулений результата деңгейлік теста (/platform/reset-unt) —
// DELETE в основной платформе необратим (не "мягкое" удаление). Пишем ПОСЛЕ
// успешного удаления (тот же принцип, что у PlatformEmailChange): журналировать
// несделанное нельзя, а сбой самой записи журнала не должен превращать уже
// случившееся удаление в ответ "ошибка" клиенту.
model UntResultReset {
  id            String   @id @default(cuid())
  actor         String
  untId         String
  untName       String?
  resultId      String
  studentEmail  String?
  studentName   String?
  // finishTime результата на момент удаления — подтверждение, что тест
  // правда был завершён, а не обнулили то, что ещё решалось.
  finishTimeWas String?
  at            DateTime @default(now())

  @@index([at])
  @@index([resultId])
}
